<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Gvn.GvnFramework paketleri repoda tutulur: temiz klon ve CI ek kurulum olmadan derlenir.
         Güncellemek için: scripts/update-framework-packages.sh. BaGet/GitHub Packages'a geçilirse bu satırı değiştirmek yeterli. -->
    <add key="GvnFramework" value="packages/gvnframework" />
  </packageSources>
  <!-- Gvn.* paketleri yalnızca yerel kaynaktan gelir (dependency-confusion koruması). -->
  <packageSourceMapping>
    <packageSource key="GvnFramework">
      <package pattern="Gvn.GvnFramework.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
