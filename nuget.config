<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Gvn.GvnFramework paketleri: `dotnet pack -o artifacts` çıktısı. BaGet'e taşındığında bu satırı değiştirmek yeterli. -->
    <add key="GvnFramework" value="../Gvn.GvnFramework/artifacts" />
  </packageSources>
  <!-- Gvn.* paketleri yalnızca yerel kaynaktan gelir (dependency-confusion koruması). -->
  <packageSourceMapping>
    <packageSource key="GvnFramework">
      <package pattern="Gvn.GvnFramework.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
