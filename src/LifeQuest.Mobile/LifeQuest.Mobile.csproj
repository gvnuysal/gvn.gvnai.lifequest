<Project Sdk="Microsoft.NET.Sdk">

  <!-- LifeQuest mobil uygulaması (iOS + Android). CI'daki LifeQuest.slnx'e girmez; LifeQuest.Mobile.slnx ile açılır. -->
  <PropertyGroup>
    <!-- Directory.Build.props'taki tek hedef (net10.0) yerine platform hedefleri. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LifeQuest.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>LifeQuest</ApplicationTitle>
    <ApplicationId>com.gvnaitech.lifequest</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- .NET for iOS 26.5.10318 Xcode 26.6 istiyor; yerelde kurulu 26.5 ile geliştirme derlemesi yapılabilsin diye sürüm
       kontrolü Debug'da kapalı. Yayın derlemesi (Release) doğru Xcode ister. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <!-- Android derlemesi: Android Studio ile gelen JDK ve SDK. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('/Applications/Android Studio.app/Contents/jbr/Contents/Home')">/Applications/Android Studio.app/Contents/jbr/Contents/Home</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(HOME)/Library/Android/sdk')">$(HOME)/Library/Android/sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <!-- Geliştirme sürümünde API adresi yerel sunucu; Release'de LifeQuestApiBaseUrl ile verilir. -->
  <PropertyGroup>
    <LifeQuestApiBaseUrl Condition="'$(LifeQuestApiBaseUrl)' == ''"></LifeQuestApiBaseUrl>
    <LifeQuestWebBaseUrl Condition="'$(LifeQuestWebBaseUrl)' == ''">https://lifequesttest.gvnaitech.com</LifeQuestWebBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LifeQuestApiBaseUrl</_Parameter1>
      <_Parameter2>$(LifeQuestApiBaseUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LifeQuestWebBaseUrl</_Parameter1>
      <_Parameter2>$(LifeQuestWebBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F26B4F" ForegroundScale="0.7" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F26B4F" BaseSize="160,160" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiImage Include="Resources\Images\*.svg" BaseSize="24,24" />
    <None Include="Resources\Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Plugin.LocalNotification" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LifeQuest.Mobile.Core\LifeQuest.Mobile.Core.csproj" />
  </ItemGroup>

</Project>
