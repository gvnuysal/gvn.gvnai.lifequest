<?xml version="1.0" encoding="utf-8" ?>
<v:LoadingPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:c="clr-namespace:LifeQuest.Mobile.Controls"
               xmlns:v="clr-namespace:LifeQuest.Mobile.Views"
               xmlns:vm="clr-namespace:LifeQuest.Mobile.Core.ViewModels;assembly=LifeQuest.Mobile.Core"
               x:Class="LifeQuest.Mobile.Views.MyQuestsPage"
               x:DataType="vm:MyQuestsViewModel"
               x:Name="Root">
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,120" Spacing="16">
                <Label Text="{c:Tr Quests.Title}" Style="{StaticResource H1}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <c:ChoiceView Kind="Segment" Text="{c:Tr Quests.TabActive}" IsSelected="{Binding ShowActive}"
                                  Command="{Binding ShowTabCommand}" CommandParameter="active" />
                    <c:ChoiceView Grid.Column="1" Kind="Segment" Text="{c:Tr Quests.TabHistory}" IsSelected="{Binding ShowHistory}"
                                  Command="{Binding ShowTabCommand}" CommandParameter="history" />
                </Grid>

                <!-- Devam edenler -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowActive}">
                    <c:EmptyState IsVisible="{Binding LoadError, Converter={StaticResource HasValue}}" Icon="info" Title="{c:Tr Quests.LoadFailed}"
                                  Message="{Binding LoadError}" ActionText="{c:Tr Mobile.Retry}" ActionCommand="{Binding RefreshCommand}" />
                    <c:EmptyState IsVisible="{Binding NoActive}" Icon="list" Title="{c:Tr Quests.NoneActive}" Message="{c:Tr Quests.NoneActiveHint}"
                                  ActionText="{c:Tr Quests.Browse}" ActionCommand="{Binding BrowseCommand}" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Active}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <c:QuestCard ShowExplanation="False">
                                    <c:QuestCard.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenQuestCommand, Source={RelativeSource AncestorType={x:Type vm:MyQuestsViewModel}}}" CommandParameter="{Binding Id}" />
                                    </c:QuestCard.GestureRecognizers>
                                </c:QuestCard>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Geçmiş -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowHistory}">
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Filters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <c:ChoiceView Kind="Chip" Text="{Binding Label}" IsSelected="{Binding IsSelected}"
                                              Command="{Binding PickFilterCommand, Source={RelativeSource AncestorType={x:Type vm:MyQuestsViewModel}}}" CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <c:EmptyState IsVisible="{Binding NoHistory}" Icon="list" Title="{c:Tr Quests.NoHistory}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenQuestCommand, Source={RelativeSource AncestorType={x:Type vm:MyQuestsViewModel}}}" CommandParameter="{Binding Id}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <c:CategoryIcon Icon="{Binding Icon}" ColorKey="{Binding ColorKey}" Diameter="38" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontFamily="NunitoBold" />
                                            <Label Style="{StaticResource Small}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Category}" />
                                                        <Span Text=" · " />
                                                        <Span Text="{Binding Date}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center">
                                            <Label Text="{Binding Status}" FontSize="12" FontFamily="NunitoBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding LoadingHistory}" IsVisible="{Binding LoadingHistory}" />
                    <Button Text="{c:Tr Quests.LoadMore}" Style="{StaticResource Secondary}" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</v:LoadingPage>
