<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:LifeQuest.Mobile.Controls"
             xmlns:vm="clr-namespace:LifeQuest.Mobile.Core.ViewModels;assembly=LifeQuest.Mobile.Core"
             x:Class="LifeQuest.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,32" Spacing="18" MaximumWidthRequest="560">
            <c:LanguageSwitch HorizontalOptions="End" />
            <Border WidthRequest="72" HeightRequest="72" StrokeThickness="0" StrokeShape="RoundRectangle 20" HorizontalOptions="Center"
                    BackgroundColor="{StaticResource BrandLight}">
                <c:IconView Name="sparkles" Size="40" Color="#FFF8F1" Stroke="2.4" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Spacing="6">
                <Label Text="{c:Tr Auth.RegisterHeading}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
                <Label Text="{c:Tr Auth.RegisterLead}" Style="{StaticResource Muted}" FontSize="16" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{c:Tr Auth.DisplayName}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding DisplayName}" MaxLength="50" AutomationId="RegisterName" />
                        </Border>
                        <Label Text="{Binding DisplayNameError}" Style="{StaticResource FieldError}" IsVisible="{Binding DisplayNameError, Converter={StaticResource HasValue}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{c:Tr Auth.Email}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding Email}" Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationId="RegisterEmail" />
                        </Border>
                        <Label Text="{Binding EmailError}" Style="{StaticResource FieldError}" IsVisible="{Binding EmailError, Converter={StaticResource HasValue}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{c:Tr Auth.Password}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding Password}" IsPassword="True" AutomationId="RegisterPassword" />
                        </Border>
                        <Label Text="{c:Tr Auth.PasswordRule}" Style="{StaticResource Small}" />
                        <Label Text="{Binding PasswordError}" Style="{StaticResource FieldError}" IsVisible="{Binding PasswordError, Converter={StaticResource HasValue}}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{c:Tr Auth.BirthYear}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Input}">
                            <Entry Text="{Binding BirthYear}" Keyboard="Numeric" MaxLength="4" AutomationId="RegisterBirthYear" />
                        </Border>
                        <Label Text="{c:Tr Auth.BirthYearHint}" Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                    <Label Text="{Binding Error}" Style="{StaticResource FieldError}" IsVisible="{Binding Error, Converter={StaticResource HasValue}}" />
                    <Grid>
                        <Button Text="{c:Tr Auth.CreateAccount}" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                AutomationId="RegisterSubmit" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="End" Margin="0,0,16,0" Color="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="{c:Tr Auth.HaveAccount}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Label Text="{c:Tr Auth.Login}" Style="{StaticResource Link}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
