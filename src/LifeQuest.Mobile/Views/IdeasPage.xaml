<?xml version="1.0" encoding="utf-8" ?>
<v:LoadingPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:c="clr-namespace:LifeQuest.Mobile.Controls"
               xmlns:v="clr-namespace:LifeQuest.Mobile.Views"
               xmlns:vm="clr-namespace:LifeQuest.Mobile.Core.ViewModels;assembly=LifeQuest.Mobile.Core"
               x:Class="LifeQuest.Mobile.Views.IdeasPage"
               x:DataType="vm:IdeasViewModel"
               x:Name="Root">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,120" Spacing="14">
            <Button Text="{c:Tr Common.Back}" Style="{StaticResource Ghost}" HorizontalOptions="Start" Clicked="OnBack" Padding="0,8" />
            <Label Text="{c:Tr Ideas.Title}" Style="{StaticResource H1}" />
            <Label Text="{c:Tr Ideas.Lead}" Style="{StaticResource Muted}" FontSize="16" />

            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{c:Tr Ideas.TitleLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Input}">
                        <Entry Text="{Binding IdeaTitle}" Placeholder="{c:Tr Ideas.TitlePlaceholder}" MaxLength="80" />
                    </Border>
                    <Label Text="{c:Tr Ideas.Description}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Input}" Padding="10,4">
                        <Editor Text="{Binding Description}" Placeholder="{c:Tr Ideas.DescriptionPlaceholder}" MaxLength="300" AutoSize="TextChanges" MinimumHeightRequest="96" />
                    </Border>
                    <Label Text="{Binding DescriptionCount}" Style="{StaticResource Small}" />
                    <Label Text="{c:Tr Ideas.Area}" Style="{StaticResource FieldLabel}" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <c:ChoiceView Kind="Chip" Text="{Binding Label}" Icon="{Binding Icon}" ColorKey="{Binding ColorKey}" IsSelected="{Binding IsSelected}"
                                              Command="{Binding PickCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:IdeasViewModel}}}" CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{c:Tr Ideas.Minutes}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Input}">
                                <Entry Text="{Binding Minutes}" Keyboard="Numeric" MaxLength="3" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{c:Tr Ideas.Outdoor}" Style="{StaticResource FieldLabel}" />
                            <Switch IsToggled="{Binding IsOutdoor}" HorizontalOptions="Start"
                                    OnColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{c:Tr Ideas.Cost}" Style="{StaticResource FieldLabel}" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Costs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <c:ChoiceView Kind="Chip" Text="{Binding Label}" IsSelected="{Binding IsSelected}"
                                              Command="{Binding PickCostCommand, Source={RelativeSource AncestorType={x:Type vm:IdeasViewModel}}}" CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="{Binding Error}" Style="{StaticResource FieldError}" IsVisible="{Binding Error, Converter={StaticResource HasValue}}" />
                    <Button Text="{c:Tr Ideas.Submit}" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{c:Tr Ideas.Mine}" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <c:EmptyState IsVisible="{Binding NoIdeas}" Icon="sparkles" Title="{c:Tr Ideas.EmptyTitle}" Message="{c:Tr Ideas.EmptyHint}" />
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Ideas}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Null}">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Title}" FontFamily="NunitoBold" />
                                    <Border Grid.Column="1" Style="{StaticResource Pill}">
                                        <Label Text="{Binding Status}" FontSize="12" FontFamily="NunitoBold" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding Meta}" Style="{StaticResource Small}" />
                                <Label Text="{Binding ReviewNote}" Style="{StaticResource Muted}" IsVisible="{Binding HasReviewNote}" />
                                <Button Text="{c:Tr Ideas.Withdraw}" Style="{StaticResource Ghost}" HorizontalOptions="Start" IsVisible="{Binding CanWithdraw}"
                                        Command="{Binding WithdrawCommand, Source={RelativeSource AncestorType={x:Type vm:IdeasViewModel}}}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</v:LoadingPage>
