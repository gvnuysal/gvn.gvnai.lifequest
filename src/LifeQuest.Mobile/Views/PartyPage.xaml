<?xml version="1.0" encoding="utf-8" ?>
<v:LoadingPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:c="clr-namespace:LifeQuest.Mobile.Controls"
               xmlns:v="clr-namespace:LifeQuest.Mobile.Views"
               xmlns:vm="clr-namespace:LifeQuest.Mobile.Core.ViewModels;assembly=LifeQuest.Mobile.Core"
               x:Class="LifeQuest.Mobile.Views.PartyPage"
               x:DataType="vm:PartyViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,120" Spacing="16">
            <Button Text="{c:Tr Party.BackToToday}" Style="{StaticResource Ghost}" HorizontalOptions="Start" Command="{Binding GoTodayCommand}" Padding="0,8" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsLoaded, Converter={StaticResource Not}}" />
            <c:EmptyState IsVisible="{Binding LoadError, Converter={StaticResource HasValue}}" Icon="users" Title="{c:Tr Party.OpenFailed}"
                          Message="{Binding LoadError}" ActionText="{c:Tr Party.BackToToday}" ActionCommand="{Binding GoTodayCommand}" />
            <Border Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsLoaded}">
                <VerticalStackLayout Spacing="12">
                    <c:CategoryIcon Icon="{Binding Icon}" ColorKey="{Binding ColorKey}" Diameter="56" />
                    <Label Text="{Binding Heading}" Style="{StaticResource Kicker}" />
                    <Label Text="{Binding QuestTitle}" Style="{StaticResource H1}" />
                    <Label Text="{Binding CategoryLabel}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
                    <Label Text="{c:Tr Party.Rules}" Style="{StaticResource Small}" />
                    <Button Text="{c:Tr Party.GoToQuest}" Command="{Binding GoToQuestCommand}" IsVisible="{Binding IsMember}" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding CanJoin}">
                        <Button Text="{c:Tr Party.Join}" Command="{Binding JoinCommand}" />
                        <Label Text="{c:Tr Party.JoinHint}" Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                    <Label Text="{c:Tr Party.Closed}" Style="{StaticResource Muted}" IsVisible="{Binding IsClosed}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</v:LoadingPage>
