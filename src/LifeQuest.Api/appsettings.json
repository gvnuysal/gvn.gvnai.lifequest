{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LifeQuest": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "LifeQuest",
    "Audience": "LifeQuest.Clients",
    "ExpiryMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 30
  },
  "Cache": {
    "UseRedis": false,
    "ConnectionString": "localhost:6380",
    "Prefix": "lifequest:",
    "DefaultExpiryMinutes": 30
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Hangfire": {
    "StorageProvider": "PostgreSql",
    "WorkerCount": 2,
    "EnableDashboard": false
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedCatalog": true
  },
  "Quests": {
    "DailyOfferCount": 3,
    "MaxActiveQuests": 5,
    "MaxSuggestionRoundsPerDay": 3,
    "SuggestionCount": 3,
    "SuggestionTtlHours": 6,
    "HistoryWindowDays": 30
  },
  "Recommendation": {
    "InterestChill": 0.4,
    "InterestExplore": 0.3,
    "InterestSurpriseMe": 0.2,
    "NoveltyChill": 0.05,
    "NoveltyExplore": 0.2,
    "NoveltySurpriseMe": 0.25,
    "Context": 0.15,
    "GoalFit": 0.15,
    "Diversity": 0.1,
    "FeedbackFit": 0.1,
    "Repetition": 0.25,
    "Friction": 0.15,
    "Risk": 0.3
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Gvn": {
    "Pipeline": {
      "Logging": {
        "RequestPayload": "OptIn",
        "ResponsePayload": "None",
        "CompletedLevel": "Information"
      },
      "Performance": {
        "ThresholdMs": 500
      }
    }
  },
  "Narration": {
    "TimeoutMilliseconds": 2000
  },
  "Admin": {
    "BootstrapEmails": []
  }
}