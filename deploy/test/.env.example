# LifeQuest test ortamı gizli değerleri.
# Bu dosyayı ~/.lifequest-test/.env olarak kopyalayın (repo dışında kalır, runner checkout'undan etkilenmez):
#   mkdir -p ~/.lifequest-test && cp deploy/test/.env.example ~/.lifequest-test/.env && chmod 600 ~/.lifequest-test/.env

# Alan adları (hosts kaydı ve Caddy bunları kullanır)
UI_HOST=lifequesttest.gvnaitech.com
API_HOST=lifequesttestapi.gvnaitech.com

# internal = yerel sertifika otoritesi (yalnızca bu makine). İnternete açarken e-posta adresi yazın (Let's Encrypt).
TLS_MODE=internal

# En az 32 bayt, rastgele:  openssl rand -base64 48
JWT_SECRET=
# Rastgele:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Kayıt olunca admin rolü alacak hesap
ADMIN_EMAIL=admin@lifequest.local
